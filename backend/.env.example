# ─── Server ───────────────────────────
NODE_ENV=production
PORT=5000

# ─── Supabase (required) ──────────────
# Get these from your Supabase project dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Database (Supabase PostgreSQL) ────
# Get from Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:password@aws-0-region.pooler.supabase.com:5432/postgres?schema=public

# ─── QR Token JWT ─────────────────────
# Used to sign QR code tokens for reservation check-in
QR_SECRET=qr-secret-change-in-production

# ─── Email (optional) ─────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@smartshuttle.com

# ─── App ──────────────────────────────
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=uploads
