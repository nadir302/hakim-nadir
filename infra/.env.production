# ─────────────────────────────────────────────
# Smart Shuttle — Production Environment
# Source this before docker compose commands:
#   set -a; source .env.production; set +a
# Or keep as companion to .env for reference
# ─────────────────────────────────────────────

# Supabase (from Vercel/Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Domain (used by Let's Encrypt cert)
DOMAIN=your-domain.com
ADMIN_EMAIL=admin@your-domain.com
